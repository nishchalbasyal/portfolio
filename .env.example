# GitHub Pages Configuration
# Update basePath in next.config.js to match your repository name
# e.g., if your repo is 'ai-portfolio', set basePath to '/ai-portfolio'

# Example for custom domain (optional)
# NEXT_PUBLIC_SITE_URL=https://yourportfolio.com

# Example for analytics (optional)
# NEXT_PUBLIC_GA_ID=your-google-analytics-id
